      "enhancementName": "Dakkamek",
      "unitKeywordsAll": [
        "Faction: Orks",
        "Mek"
      ],
      "restriction": "MEK model only.",
      "source": "Faction Pack - Orks v1.1, page 6"
    },
    {
      "id": "aug26-orks-careen",
      "kind": "stratagem-replace",
      "target": {
        "faction": "Xenos - Orks"
      },
      "detachmentName": "War Horde",
      "stratagemName": "Careen!",
      "description": "WHEN: Any phase, just after an ORKS VEHICLE unit from your army with the Deadly Demise ability is destroyed. TARGET: That destroyed ORKS VEHICLE unit, if you roll a 6 for its Deadly Demise ability. You can use this stratagem on that unit even though it was just destroyed. EFFECT: Your unit can make a Normal or Fall Back move before its Deadly Demise ability is resolved and before any embarked units perform an emergency disembark move. When making this move, your unit can move over enemy units, excluding MONSTERS and VEHICLES, as if they were not there.",
      "source": "Faction Pack - Orks v1.2, page 24"
    },
    {
      "id": "aug26-orks-rivetin-dakka",
      "kind": "rule-replace",
      "target": {
        "faction": "Xenos - Orks"
      },
      "unitNames": [
        "Kustom Boosta-blasta"
      ],
      "ruleName": "Rivetin' Dakka",
      "description": "In your Shooting phase, after this model has shot, select one enemy unit hit by one or more of those attacks made with a rivet kannon. Until the start of your next turn, that enemy unit is suppressed. While a unit is suppressed, each time a model in that unit makes a ranged attack, subtract 1 from the Hit roll.",
      "source": "Faction Pack - Orks v1.2, page 26"
    },
    {
      "id": "aug26-orks-mob-mentality",
      "kind": "detachment-rule-replace",
      "target": {
        "faction": "Xenos - Orks"
      },
      "detachmentName": "Green Tide",
      "ruleName": "Mob Mentality",
      "description": "Each time an attack targets a BOYZ unit from your army, models in that unit have a 6+ invulnerable save against that attack. Each time an attack targets a BOYZ unit from your army that contains 10 or more models, models in that unit have a 5+ invulnerable save against that attack. When resolving an attacking unit's attacks, the number of models in the target unit when it was targeted determines that unit's invulnerable save until those attacks are resolved; do not change the save partway through those attacks as casualties are removed.",
      "source": "Faction Pack - Orks v1.2, pages 26-27"
    },
    {
      "id": "aug26-orks-mekanised-brutality",
      "kind": "stratagem-replace",
      "target": {
        "faction": "Xenos - Orks"
      },
      "detachmentName": "Blitz Brigade",
      "stratagemName": "Mekanised Brutality",
      "description": "WHEN: Your Movement phase, just after an ORKS TRANSPORT unit from your army ends a Normal move. TARGET: That TRANSPORT unit. EFFECT: Units embarked within your TRANSPORT can make an assault disembark move as described in Core Rules 18.06.",
      "source": "Faction Pack - Orks v1.2, page 24"
    },
    {
      "id": "aug26-space-marines-wardens-heroes",
      "kind": "rule-remove",
      "target": {
        "faction": "Imperium - Adeptus Astartes - Ultramarines"
      },
      "unitNames": [
        "Wardens of Ultramar"
      ],
      "ruleName": "Heroes of Ultramar",
      "source": "Faction Pack - Space Marines v1.2"
    }
