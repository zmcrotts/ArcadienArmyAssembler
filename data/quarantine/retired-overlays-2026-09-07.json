    {
      "id": "orks-go-get-em",
      "kind": "stratagem-replace",
      "target": {
        "faction": "Xenos - Orks"
      },
      "stratagemName": "Go Get 'Em!",
      "description": "WHEN: Your opponent's Shooting phase, when an enemy unit that targeted a friendly unengaged BOYZ unit this phase has shot. TARGET: That BOYZ unit. EFFECT: Your unit can make a surge move of up to D6\".",
      "source": "Faction Pack - Orks v1.1, page 24"
    },
