  "factionPackUpdates": [
    {
      "id": "orks-boomdakka-billowing-fumes",
      "kind": "rule-replace",
      "target": {
        "faction": "Xenos - Orks"
      },
      "unitNames": [
        "Boomdakka Snazzwagon"
      ],
      "ruleName": "Billowing Fumes",
      "description": "While an enemy unit (excluding MONSTER/VEHICLE units) is within 6\" of this unit, when that enemy unit is selected to shoot, that unit's targets have the benefit of cover until that unit has shot.",
      "source": "Faction Pack - Orks v1.1, page 25"
    },
    {
      "id": "orks-shokkjump-shokk-tunnel",
      "kind": "rule-replace",
      "target": {
        "faction": "Xenos - Orks"
      },
      "unitNames": [
        "Shokkjump Dragsta"
      ],
      "ruleName": "Shokk Tunnel",
      "description": "In your Movement phase, when this unit is selected to make an advance move, you can use this ability. If you do: that move has no maximum distance; this unit can move through all types of model (including enemy models and MONSTER/VEHICLE models); after moving, your unit must be more than 8\" horizontally from all enemy units.",
      "source": "Faction Pack - Orks v1.1, page 26"
    },
    {
